{
  "name": "baan-rao-expenses",
  "account_id": "217f7d6c1ae649af0033f8efeef80f4f",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/family-home.png"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baan-rao-expenses-db",
      "database_id": "a1cdf1b5-eedf-45d1-82f3-5428d09855d0",
      "migrations_dir": "drizzle"
    }
  ],
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ]
}
